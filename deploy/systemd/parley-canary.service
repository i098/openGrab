[Unit]
Description=openGrab daily Meet canary (Phase 0 exit check on the attached Chromium)
Documentation=https://github.com/i098/openGrab/blob/main/crates/parley-join/README.md

[Service]
Type=oneshot
# Settings live outside the repository. See "Daily canary" in crates/parley-join/README.md.
EnvironmentFile=%h/.config/parley/canary.env
# The unit runs the copy in ~/.local/share/parley/canary/. Copy scripts/canary.sh and p0_exit there first.
ExecStart=%h/.local/share/parley/canary/canary.sh
TimeoutStartSec=2h
